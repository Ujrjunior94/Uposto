# GEMINI_API_KEY: Required for Gemini AI API calls (e.g. ANP audit, fuel laudo OCR).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEEPSEEK_API_KEY: Chave da API do DeepSeek para reconhecimento e estruturação inteligente da escala (https://platform.deepseek.com).
DEEPSEEK_API_KEY=""

# DEEPSEEK_MODEL: Modelo DeepSeek (padrão: deepseek-chat ou deepseek-reasoner).
DEEPSEEK_MODEL="deepseek-chat"

# OPENROUTER_API_KEY: Chave da API do OpenRouter para leitura óptica multimodal da imagem da escala.
OPENROUTER_API_KEY=""

# OPENROUTER_MODEL: Modelo multimodal do OpenRouter para análise da imagem da escala (padrão: modelo multimodal gratuito).
OPENROUTER_MODEL="google/gemini-2.0-flash-lite-preview-02-05:free"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Leitura de escalas: use GEMINI_API_KEY no servidor; nunca prefixe a chave com VITE_.
SCHEDULE_GEMINI_MODEL="gemini-flash-latest"
# Alternativa com OPENROUTER_API_KEY: escolha um modelo com entrada de imagem.
SCHEDULE_OPENROUTER_MODEL=""
